{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "quizlab",
	"compatibility_date": "2026-11-19",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wdm-database",
			"database_id": "7a41c89f-52a0-4c09-9f34-9e71cedbc74c",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"logs": {
	    	"enabled": false,
	    	"invocation_logs": true
		}
	},
	"workers_dev": true,
	"preview_urls": true
}
